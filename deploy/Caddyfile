# HTTPS del stack de Caja de Barrio en el VPS. Los certificados los emite Let's Encrypt
# la primera vez que llega una petición a cada nombre (no hace falta correo). DOMINIO y el
# usuario de la UI llegan como variables de entorno desde deploy/compose.vps.yml.

# Open Payments: documentos de wallet address, incoming/outgoing payments y quotes.
op.{$DOMINIO} {
	encode gzip
	reverse_proxy rafiki-backend:3000
}

# Servidor de autorización GNAP. El navegador del usuario abre /interact/... aquí.
auth.{$DOMINIO} {
	encode gzip
	reverse_proxy rafiki-auth:3006
}

# Backend Go: IdP del grant interactivo (/idp/) y, después, la API /internal de los MCP.
# Los webhooks de Rafiki llegan por la red interna; desde afuera exigen firma igual.
backend.{$DOMINIO} {
	encode gzip
	reverse_proxy backend:8000
}

# Agente: UI de ADK (con usuario y clave) y gateway. Los webhooks y la vuelta de la billetera quedan
# públicos porque los llaman Meta, Didit y el navegador de la persona; /internal/avisos exige su token.
agente.{$DOMINIO} {
	encode gzip
	@publico path /webhook/* /didit/* /op/finish* /politicas /internal/avisos /health
	handle @publico {
		reverse_proxy agente:8080
	}
	handle {
		basic_auth {
			{$ADMIN_UI_USUARIO} {$ADMIN_UI_HASH}
		}
		reverse_proxy agente:8080
	}
}

# UI de administración de Rafiki. La imagen corre sin autenticación propia
# (AUTH_ENABLED=false), así que nunca se publica sin usuario y clave.
admin.{$DOMINIO} {
	basic_auth {
		{$ADMIN_UI_USUARIO} {$ADMIN_UI_HASH}
	}
	reverse_proxy rafiki-admin:3010
}
