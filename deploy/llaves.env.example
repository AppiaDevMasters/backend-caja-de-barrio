# Llaves de proveedores del backend en el VPS.
#
# Cómo se usa (en el VPS, desde /opt/backend-caja-de-barrio):
#   1. deploy/instalar.sh crea deploy/llaves.env a partir de este archivo la primera vez.
#   2. Llena los valores:   nano deploy/llaves.env
#   3. Aplica:              sudo ./deploy/instalar.sh
#
# deploy/llaves.env NO se versiona (está en .gitignore) y queda con permisos 600. Este archivo
# solo lleva los nombres. Nunca pegues las llaves en el chat, en un commit ni en una captura.
#
# Las llaves de Open Payments (Rafiki), la base y el SERVICIO_TOKEN no van aquí: las genera
# deploy/instalar.sh y viven en rafiki/.env.

# --- Didit (https://business.didit.me) ---------------------------------------------------
# API key de la aplicación (Settings → API & Webhooks).
DIDIT_API_KEY=
# Workflow de REGISTRO: documento + prueba de vida + face match contra el documento. Se usa al dar
# de alta a una persona (motivo "alta") y al tendero creado en el panel (motivo "alta_tendero").
# De aquí salen el número y el nombre del documento que luego valida Verifik.
DIDIT_WORKFLOW_ID=
# Workflow BIOMÉTRICO: solo prueba de vida + comparación de la cara con la ya registrada. Se usa al
# empezar cada retiro (motivo "retiro"), sin volver a pedir el documento.
DIDIT_BIOMETRIC_WORKFLOW_ID=
# A dónde vuelve el navegador al terminar Didit: la página del agente consulta la decisión y avisa
# en el chat (no hace falta webhook). El webhook, si se configura en la consola, va a /webhook/didit.
DIDIT_CALLBACK_URL=https://agente.cajadebarrio.lat/didit/retorno
# Opcional: secreto para verificar la firma X-Signature-V2 del webhook. Si queda vacío, el backend
# no confía en el cuerpo del webhook: vuelve a pedirle la decisión a la API de Didit con la API key.
DIDIT_WEBHOOK_SECRET=

# --- Verifik: validación de la cédula contra la Registraduría -----------------------------
# Token de la API de Verifik (va como "Authorization: Bearer ...").
VERIFIK_API_KEY=

# --- Billetera virtual de la demo --------------------------------------------------------
# Saldo con el que nace una persona al registrarse (en pesos, entero).
SALDO_INICIAL_DEMO_COP=1000000

# --- Avisos al agente y panel -------------------------------------------------------------
# El backend le pide al agente que le avise a una persona (decisiones del panel).
AGENTE_URL=http://agente:8080
# Orígenes que pueden llamar /admin con cookie (CORS). Separados por coma.
PANEL_ORIGINS=https://panel.cajadebarrio.lat,http://localhost:3000
# Claves de los usuarios del panel (super, cumplimiento, soporte). Si quedan vacías, instalar.sh las
# genera y las guarda aquí; se leen con: grep PANEL_CLAVE deploy/llaves.env
PANEL_CLAVE_SUPERADMIN=
PANEL_CLAVE_CUMPLIMIENTO=
PANEL_CLAVE_SOPORTE=

# --- Open Payments ------------------------------------------------------------------------
# En el VPS las wallets y el servidor de autorización se sirven por https real (Caddy): el
# cliente de Open Payments los usa tal cual, sin degradar a http ni reescribir hosts.
OP_TLS=true
