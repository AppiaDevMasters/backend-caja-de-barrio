# Nombres de las variables del backend de Caja de Barrio (cmd/backend y cmd/seed).
#
# Este archivo NO lleva secretos: solo nombres y valores de ejemplo no sensibles.
# Los valores reales viven en rafiki/.env, que genera rafiki/scripts/init.sh, esta
# ignorado por git y es el que usa rafiki/docker-compose.yml. La referencia completa,
# variable por variable, esta en docs/configuracion.md.
#
# Para correr el backend fuera de Docker, exporta las variables desde rafiki/.env
# mapeando los cuatro nombres que difieren:
#   OPERATOR_TENANT_ID        -> RAFIKI_TENANT_ID
#   ADMIN_API_SECRET          -> RAFIKI_ADMIN_API_SECRET
#   SIGNATURE_SECRET          -> RAFIKI_SIGNATURE_SECRET
#   IDENTITY_SERVER_SECRET    -> RAFIKI_IDENTITY_SERVER_SECRET

# --- Servidor HTTP ---------------------------------------------------------
# Direccion de escucha. El puerto 8000 es el que rafiki/docker-compose.yml publica
# para que el navegador del usuario abra el IdP.
HTTP_ADDR=:8000
LOG_LEVEL=info

# --- Rafiki ----------------------------------------------------------------
# Admin API (GraphQL) del servidor de recursos. Dentro de la red `rafiki` se alcanza
# por nombre de servicio, no por localhost.
RAFIKI_ADMIN_URL=http://rafiki-backend:3001/graphql
# URL publica de las wallet addresses del ASE; el valor efectivo por tenant vive en el
# ajuste WALLET_ADDRESS_URL de la base.
RAFIKI_OPEN_PAYMENTS_URL=http://localhost:3000
# Tenant operador de rafiki/.env.
RAFIKI_TENANT_ID=
# Secreto de la Admin API de rafiki/.env.
RAFIKI_ADMIN_API_SECRET=
# Clave que verifica la firma Rafiki-Signature de cada webhook.
RAFIKI_SIGNATURE_SECRET=
# Secreto compartido con el IdP (cabecera x-idp-secret).
RAFIKI_IDENTITY_SERVER_SECRET=
# Direccion servidor a servidor del auth server: dentro de la red es el nombre del
# servicio. NO es el AUTH_SERVER_URL de rafiki/.env, que es la publica y desde el
# contenedor da timeout.
RAFIKI_AUTH_SERVER_URL=http://rafiki-auth:3006
# Servidor de interaccion del auth server, que es donde el IdP lee y resuelve la
# interaccion (/grant/{id}/{nonce}). NO es la direccion que abre el navegador
# (/interact/{id}/{nonce} en el puerto 3006): llamar a esa desde el IdP da 404.
RAFIKI_INTERACTION_SERVER_URL=http://rafiki-auth:3009
# Direccion que abre el navegador del usuario para cerrar la interaccion (redirect final).
RAFIKI_AUTH_SERVER_PUBLIC_URL=http://localhost:3006

# --- Identidad Open Payments del backend (cliente) -------------------------
#
# Wallet address de este backend: la identidad con la que firma sus peticiones y con la
# que resuelve la de los demas. Vacia significa la base publica mas la cuenta de la
# aplicacion, que es el nombre con el que el seed registra la clave, asi que los dos no
# se separan al cambiar la base.
OP_CLIENT_WALLET_ADDRESS=
#
# kid del JWK registrado en la wallet address; vacio lo nombra con su huella RFC 7638.
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=keys/op-private-key.pem
# https real (true en el VPS): el cliente usa las URLs públicas sin degradar a http.
OP_TLS=
# propio (por defecto) o testnet (docs/modo-testnet.md).
OP_MODO=propio
# Solo con OP_MODO=testnet: las wallets de la demo y el tope del cupo en la moneda del cliente.
OP_TESTNET_WALLET_CLIENTE=
OP_TESTNET_WALLET_TIENDA=
OP_TESTNET_CUPO=

# --- Capa de datos y superficie interna ------------------------------------
#
# DSN de PostgreSQL con PostGIS para el esquema del contrato (las once tablas).
# Lleva credencial y no se imprime nunca: los mensajes del store nombran host,
# puerto y base. Sin esta variable el backend sirve igual los endpoints que
# Rafiki llama, y la superficie /internal no se monta.
DATABASE_URL=postgres://caja:cambiar@db:5432/caja_de_barrio

# Lo que los MCP mandan en la cabecera X-Servicio-Token. Sin el, la superficie
# /internal no se monta: una superficie sin token quedaria abierta.
SERVICIO_TOKEN=

# --- Proveedores -----------------------------------------------------------
#
# Token de Verifik para validar la cedula colombiana. Sin el, la ruta de cedula
# esta montada igual y responde que no esta configurada, en vez de dejar al
# llamador con una ruta que no existe.
VERIFIK_TOKEN=

# Credenciales de Didit para identidad biométrica. Se requieren para C8; no están
# disponibles en este repositorio y no se deben sustituir por valores inventados.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# URL pública del webhook que Didit llamará; requiere un túnel HTTPS en el entorno real.
DIDIT_CALLBACK_URL=
